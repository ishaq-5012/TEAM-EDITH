# Copy to backend/.env and adjust. Never commit real secrets.
# development | test | production. bootstrap-dev-admin only works in development.
VERIFYFLOW_ENVIRONMENT=development

# SQLite for local development. PostgreSQL in production, e.g. postgresql+psycopg://user:pass@host/verifyflow
# VERIFYFLOW_DATABASE_URL=sqlite:///./var/verifyflow.db

# Private upload storage (outside any web root).
# VERIFYFLOW_STORAGE_DIR=./var/storage
VERIFYFLOW_MAX_UPLOAD_BYTES=26214400
# Structural limits checked on every upload.
VERIFYFLOW_MAX_PDF_PAGES=500
VERIFYFLOW_MAX_IMAGE_PIXELS=60000000
VERIFYFLOW_MAX_DOCUMENTS_PER_APPLICATION=200
# A processing job still running after this long is treated as interrupted and can be retried.
VERIFYFLOW_PROCESSING_STALE_MINUTES=15
# inline (default): the API runs processing itself. worker: the API only queues jobs and
# `python -m app.cli worker` runs them (production; see deploy/.env.production.example).
VERIFYFLOW_PROCESSING_MODE=inline
# VERIFYFLOW_WORKER_POLL_SECONDS=2
# VERIFYFLOW_PROCESSING_MAX_ATTEMPTS=3

# Interactive API docs at /api/docs: on by default, off by default in production.
# VERIFYFLOW_EXPOSE_API_DOCS=true

# Logging: DEBUG | INFO | WARNING | ERROR, and text (human) or json (log shipping).
# Passwords, tokens, secrets and Authorization headers are redacted from all log output.
VERIFYFLOW_LOG_LEVEL=INFO
VERIFYFLOW_LOG_FORMAT=text

# Sessions: server-side, in an HttpOnly cookie. No signing secret is needed (tokens are random and
# stored only as SHA-256 hashes), and restarting the server does not sign anyone out.
VERIFYFLOW_SESSION_IDLE_MINUTES=30
VERIFYFLOW_SESSION_ABSOLUTE_HOURS=12
# Secure cookies (with the __Host- prefix). Browsers accept them on http://localhost.
# Set false only to test over plain HTTP on another hostname. Refused in production.
VERIFYFLOW_COOKIE_SECURE=true

# Sign-in throttling over a sliding window: per submitted email (known or not) and per client IP.
VERIFYFLOW_LOGIN_WINDOW_MINUTES=15
VERIFYFLOW_LOGIN_MAX_FAILURES=5
VERIFYFLOW_LOGIN_IP_MAX_FAILURES=30

# ---- AI assistance (Phase 9). Advisory only: validation, trust checks and review never depend on it.
# "disabled" = no-AI mode (everything works, with deterministic explanations); "anthropic" = Claude via the Anthropic SDK;
# "groq" = Groq's OpenAI-compatible API (set VERIFYFLOW_AI_MODEL, e.g. openai/gpt-oss-120b, and its prices below).
VERIFYFLOW_AI_PROVIDER=disabled
# Backend only. Set it in the server environment or a secret manager, never in frontend config. Without it, AI stays off.
# VERIFYFLOW_AI_API_KEY=
# VERIFYFLOW_AI_MODEL=claude-opus-5-5
# Optional gateway/proxy in front of the provider API (https:// in production).
# VERIFYFLOW_AI_BASE_URL=
# VERIFYFLOW_AI_EFFORT=medium
# Retry a declined request server-side on the provider's recommended fallback model.
# VERIFYFLOW_AI_REFUSAL_FALLBACK=true
# Per-attempt timeout, and retries for timeouts / provider rate limits / 5xx only.
# VERIFYFLOW_AI_TIMEOUT_SECONDS=30
# VERIFYFLOW_AI_MAX_RETRIES=2
# VERIFYFLOW_AI_MAX_OUTPUT_TOKENS=2048
# VERIFYFLOW_AI_MAX_INPUT_CHARS=24000
# Rate limits (whole process per minute; per user per hour) and a daily spend ceiling, estimated before each call.
# VERIFYFLOW_AI_RATE_LIMIT_PER_MINUTE=20
# VERIFYFLOW_AI_USER_RATE_LIMIT_PER_HOUR=60
# VERIFYFLOW_AI_DAILY_BUDGET_USD=5
# VERIFYFLOW_AI_INPUT_USD_PER_MTOK=4
# VERIFYFLOW_AI_OUTPUT_USD_PER_MTOK=20
# What document content may leave this environment:
#   none             rule and finding metadata only (no values, page text or file names)  <- default
#   extracted_values + extracted/corrected values and file names (explanations become more specific)
#   page_text        + page text (needed for document classification and field suggestions)
VERIFYFLOW_AI_DOCUMENT_EGRESS=none
# Mask identifier values (IDs, account and document numbers) to their last 4 characters before they leave.
VERIFYFLOW_AI_MASK_IDENTIFIERS=true

# Extraction: field definitions file (default: app/extraction/field_definitions.json) and OCR page budget.
# VERIFYFLOW_FIELD_DEFINITIONS_PATH=C:/verifyflow/field_definitions.json
VERIFYFLOW_OCR_MAX_PAGES=50
# Cross-document comparison groups (default: app/evidence/comparison_config.json).
# VERIFYFLOW_COMPARISON_CONFIG_PATH=C:/verifyflow/comparison_config.json

# Optional path to tesseract.exe for OCR of scanned documents.
# VERIFYFLOW_TESSERACT_CMD=C:/Program Files/Tesseract-OCR/tesseract.exe

# Browser origins allowed to call the API. Also used by the Origin check (CSRF defence in depth).
VERIFYFLOW_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# ---- Trust & Authentication Center. Nothing is trusted by default.
# Trust anchors for PDF signatures: a directory of PEM/DER CA certificates you trust (never the OS TLS store).
# For development, `python -m app.cli make-trust-fixtures` writes a SYNTHETIC root you can point this at.
# VERIFYFLOW_TRUST_ROOTS_DIR=C:/verifyflow/trust-roots
# Offline revocation: a directory of CRL files (PEM/DER).
# VERIFYFLOW_TRUST_CRL_DIR=C:/verifyflow/crls
# Online OCSP/CRL fetching from URLs embedded in certificates. Keep false unless outbound traffic goes through an
# allowlisting proxy: the URLs come from uploaded documents.
VERIFYFLOW_TRUST_REVOCATION_FETCHING=false
# Approved issuer/registry integrations: "synthetic" (development/tests only, refused in production), "http_json".
VERIFYFLOW_REGISTRY_CONNECTORS=[]
# For http_json: the approved registry endpoint (https:// required in production), display name and timeout.
# VERIFYFLOW_REGISTRY_HTTP_URL=https://registry.example.org/api/lookup
# VERIFYFLOW_REGISTRY_HTTP_NAME=Example issuer registry
# VERIFYFLOW_REGISTRY_HTTP_TIMEOUT_SECONDS=5
