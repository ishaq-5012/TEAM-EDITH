# Copy to .env (gitignored). Replace every REPLACE_ME value.
# Only upload fictional SIH evaluator data to this demo host.
VERIFYFLOW_DOMAIN=verifyflow-example.duckdns.org
PORTAL_DOMAIN=portal-example.duckdns.org
VERIFYFLOW_ENVIRONMENT=development
VERIFYFLOW_DATABASE_URL=sqlite:////app/var/verifyflow.db
VERIFYFLOW_STORAGE_DIR=/app/var/storage
VERIFYFLOW_PROCESSING_MODE=inline
VERIFYFLOW_COOKIE_SECURE=true
VERIFYFLOW_CORS_ORIGINS=["https://verifyflow-example.duckdns.org"]
VERIFYFLOW_EXPOSE_API_DOCS=false
VERIFYFLOW_AI_PROVIDER=disabled
VERIFYFLOW_TRUST_ROOTS_DIR=/app/var/institution-trust/roots
VERIFYFLOW_TRUST_CRL_DIR=/app/var/institution-trust/crls
VERIFYFLOW_REGISTRY_CONNECTORS=["synthetic"]
VERIFYFLOW_EVALUATOR_AUTOFILL=true
VERIFYFLOW_EVALUATOR_ACCOUNTS_FILE=/app/var/demo-accounts.txt
VERIFYFLOW_PORTAL_SHARED_SECRET=REPLACE_ME_SHARED_SECRET
VERIFYFLOW_PORTAL_OWNER_EMAIL=portal.intake@example.org
VERIFYFLOW_PORTAL_REVIEWER_EMAIL=reviewer.demo@example.org
VERIFYFLOW_INTAKE_SECRET=REPLACE_ME_SHARED_SECRET
PORTAL_EVALUATOR_AUTOFILL=1
SECRET_KEY=REPLACE_ME_RANDOM_SECRET
