# VerifyFlow AI — production environment template. Contains NO real secrets.
#
# Copy to deploy/.env.production on the server (never commit that file), replace every REPLACE_ME, and keep it
# readable only by the deploying account (chmod 600). Prefer injecting the secrets marked [secret] from your
# platform's secret manager instead of storing them in the file.
# tests/test_foundation.py checks that this template stays loadable in production mode.

# ---- Public hostname served over HTTPS (used by docker-compose / the reverse proxy)
VERIFYFLOW_DOMAIN=verifyflow.example.org

# ---- Core
VERIFYFLOW_ENVIRONMENT=production
VERIFYFLOW_LOG_LEVEL=INFO
# One JSON object per line for the log shipper.
VERIFYFLOW_LOG_FORMAT=json
VERIFYFLOW_EXPOSE_API_DOCS=false

# ---- PostgreSQL. The compose file's database container reads POSTGRES_*; the API reads VERIFYFLOW_DATABASE_URL.
# With a managed database (recommended), delete the POSTGRES_* lines and point the URL at it with sslmode=require.
POSTGRES_USER=verifyflow
POSTGRES_DB=verifyflow
# [secret]
POSTGRES_PASSWORD=REPLACE_ME
# [secret] Must match POSTGRES_PASSWORD when using the bundled database container.
VERIFYFLOW_DATABASE_URL=postgresql+psycopg://verifyflow:REPLACE_ME@db:5432/verifyflow

# ---- Private document storage: a persistent volume mounted outside any web root, backed up with the database.
VERIFYFLOW_STORAGE_DIR=/var/lib/verifyflow/storage

# ---- HTTPS, cookies and CORS. The SPA and /api are served from the same https origin, so CORS needs only it.
VERIFYFLOW_COOKIE_SECURE=true
VERIFYFLOW_CORS_ORIGINS=["https://verifyflow.example.org"]
VERIFYFLOW_SESSION_IDLE_MINUTES=30
VERIFYFLOW_SESSION_ABSOLUTE_HOURS=12

# ---- Sign-in throttling (application level; the reverse proxy adds per-IP request limits)
VERIFYFLOW_LOGIN_WINDOW_MINUTES=15
VERIFYFLOW_LOGIN_MAX_FAILURES=5
VERIFYFLOW_LOGIN_IP_MAX_FAILURES=30

# ---- Upload restrictions (the proxy's client_max_body_size must be slightly above MAX_UPLOAD_BYTES)
VERIFYFLOW_MAX_UPLOAD_BYTES=26214400
VERIFYFLOW_MAX_PDF_PAGES=500
VERIFYFLOW_MAX_IMAGE_PIXELS=60000000
VERIFYFLOW_MAX_DOCUMENTS_PER_APPLICATION=200

# ---- Processing: the API only queues jobs; the separate worker container runs them (survives restarts).
VERIFYFLOW_PROCESSING_MODE=worker
VERIFYFLOW_WORKER_POLL_SECONDS=2
VERIFYFLOW_PROCESSING_STALE_MINUTES=15
VERIFYFLOW_PROCESSING_MAX_ATTEMPTS=3
VERIFYFLOW_OCR_MAX_PAGES=50
# Tesseract is installed in the API/worker image and found on PATH; set this only for a non-standard location.
# VERIFYFLOW_TESSERACT_CMD=/usr/bin/tesseract

# ---- AI assistance: off unless you configure a provider and accept the egress policy below.
VERIFYFLOW_AI_PROVIDER=disabled
# [secret] Only when VERIFYFLOW_AI_PROVIDER=anthropic. Inject from a secret manager; never put it in frontend config.
# VERIFYFLOW_AI_API_KEY=
VERIFYFLOW_AI_DOCUMENT_EGRESS=none
VERIFYFLOW_AI_MASK_IDENTIFIERS=true
VERIFYFLOW_AI_DAILY_BUDGET_USD=5

# ---- Trust & Authentication Center: nothing is trusted unless you mount your own anchors.
# Mount a read-only directory of CA certificates you trust (never the synthetic development root).
# VERIFYFLOW_TRUST_ROOTS_DIR=/etc/verifyflow/trust-roots
VERIFYFLOW_TRUST_REVOCATION_FETCHING=false
VERIFYFLOW_REGISTRY_CONNECTORS=[]
